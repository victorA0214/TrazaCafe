<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@include file="Lib/Header.jsp"%><section class="page-heading"><p class="eyebrow">SEGUIMIENTO DEL LOTE</p><h1>Registrar muestra</h1><p>Relaciona la muestra con una finca existente.</p></section><form action="<%=request.getContextPath()%>/ServletMuestra" method="post" class="panel form-grid"><label>Finca de origen<select name="idFinca" required><option value="">Selecciona una finca</option><% java.util.List<Modelo.Finca> fincas = (java.util.List<Modelo.Finca>) request.getAttribute("fincas");
    if (fincas != null) {
        for (Modelo.Finca f : fincas) {%><option value="<%=f.getIdFinca()%>"><%=f.getNombre()%> — <%=f.getMunicipio()%> (ID <%=f.getIdFinca()%>)</option><%}
    }%></select><small>Si no aparecen opciones, registra primero una finca.</small></label><label>Código del lote<input name="lote" required maxlength="80" placeholder="TC-2026-001"></label><label>Variedad de café<input name="variedad" required maxlength="100"></label><label>Fecha de recolección<input type="date" name="fechaRecoleccion" required></label><label>Proceso de beneficio<select name="procesoBeneficio" required><option value="">Selecciona</option><option>Lavado</option><option>Natural</option><option>Honey</option><option>Otro</option></select></label><label>Cantidad producida<input name="cantidadProducida" maxlength="60" placeholder="20 kg"></label><div class="form-actions"><button class="button" type="submit">Guardar muestra</button></div></form><%@include file="Lib/Footer.jsp"%>