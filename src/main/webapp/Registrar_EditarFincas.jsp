<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@include file="Lib/Header.jsp"%><section class="page-heading"><p class="eyebrow">ORIGEN DEL CAFÉ</p><h1>Registrar finca</h1><p>Completa la información de la finca. El productor se toma de la sesión iniciada.</p></section><form action="<%=request.getContextPath()%>/ServletFinca" method="post" class="panel form-grid"><input type="hidden" name="accion" value="registrar"><label>Nombre de la finca<input name="nombre" required maxlength="120"></label><label>Municipio<input name="municipio" required maxlength="100"></label><label>Vereda<input name="vereda" maxlength="100"></label><label>Altitud (metros)<input name="altitud" type="number" min="0" max="6000" step="1" required placeholder="1950"></label><label>Área cultivada (hectáreas)<input name="areaCultivada" type="number" min="0" step="0.01" required></label><label>Variedad predominante<input name="variedadPredominante" maxlength="100" placeholder="Caturra, Castillo, Colombia..."></label><div class="form-actions"><button class="button" type="submit">Guardar finca</button><a class="button secondary" href="ServletFinca">Ver fincas</a></div></form><%@include file="Lib/Footer.jsp"%>